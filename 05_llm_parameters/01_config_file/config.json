{
  "model_name": "distilgpt2",

  "training": {
    "learning_rate": 5e-5,
    "batch_size": 4,
    "epochs": 3,
    "optimizer": "adamw",
    "weight_decay": 0.01
  },

  "generation": {
    "do_sample": true,
    "temperature": 0.8,
    "top_k": 50,
    "top_p": 0.95,
    "max_new_tokens": 40,
    "repetition_penalty": 1.1
  },

  "limits": {
    "context_window": 1024
  }
}
